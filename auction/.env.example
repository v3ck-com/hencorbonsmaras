# Copy to .env and replace every CHANGE_ME value with a distinct random hex secret.
# Use scripts/init-local.sh to create a local rehearsal configuration automatically.
APP_ORIGIN=https://auction.hencorbonsmaras.co.za
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_HEX
OPERATOR_PASSWORD=CHANGE_ME_OPERATOR_RANDOM_HEX
BROADCAST_PASSWORD=CHANGE_ME_BROADCAST_RANDOM_HEX
LIVEKIT_API_KEY=hencor
LIVEKIT_API_SECRET=CHANGE_ME_RANDOM_HEX_32_OR_MORE_CHARACTERS
LIVEKIT_URL=wss://media.auction.hencorbonsmaras.co.za
LIVEKIT_NODE_IP=SET_PUBLIC_SERVER_IPV4
